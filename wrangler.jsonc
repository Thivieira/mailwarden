{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailwarden",
  "account_id": "e807ef39b360b2fa610967e74892c610",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailwarden-prod",
      "database_id": "a7aef699-12eb-4ea8-946b-d77d54c944d1",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "vars": {
    "MAILBOX_MUTATIONS_ENABLED": "false",
    "ALLOW_DEV_AUTH": "false",
    "KEY_VERSION": "v1"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "alias": {
    "bun:sqlite": "./src/db/bun-sqlite-shim.ts"
  }
}
