{
  "name": "mailwarden",
  "version": "1.4.0",
  "description": "Email managed through conversation, with human-approved sending",
  "module": "apps/cloud/src/index.ts",
  "main": "apps/cloud/src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:cloud",
    "dev:cloud": "bun run ui:build && bun run --watch apps/cloud/src/index.ts",
    "dev:bridge": "bun run apps/bridge/src/daemon.ts",
    "bridge": "bun run apps/bridge/src/cli.ts",
    "bridge:daemon": "bun run apps/bridge/src/daemon.ts",
    "start": "bun run apps/cloud/src/index.ts",
    "build": "bun run deploy:dry",
    "test": "bun run ui:build && bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun run ui:build && tsc --noEmit && tsc --noEmit -p src/mcp/ui/apps",
    "ui:build": "bun run src/ui/build.ts",
    "deploy": "bun run typecheck && bun test && wrangler deploy",
    "ship": "bash scripts/ship.sh",
    "deploy:dry": "bun run ui:build && wrangler deploy --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate:remote": "bash scripts/d1.sh d1 migrations apply mailwarden-prod --remote",
    "db:migrate:status": "bash scripts/d1.sh d1 migrations list mailwarden-prod --remote",
    "d1": "bash scripts/d1.sh",
    "db:seed": "bun run src/scripts/dev-seed.ts",
    "mcp:stdio": "bun run src/scripts/mcp-stdio.ts",
    "proton:gateway": "bun run apps/bridge/src/gateway.ts",
    "beta:provision": "bun run src/scripts/invite-user.ts",
    "invite:create": "bun run scripts/create-invite.ts",
    "replay": "bun run src/scripts/replay.ts",
    "test:live": "bun run scripts/test-mailwarden.ts"
  },
  "dependencies": {
    "@mailwarden/auth": "workspace:*",
    "@mailwarden/contracts": "workspace:*",
    "@mailwarden/db": "workspace:*",
    "@mailwarden/organizations": "workspace:*",
    "@mailwarden/proton": "workspace:*",
    "@mailwarden/relay": "workspace:*",
    "@mailwarden/triage-events": "workspace:*",
    "@mailwarden/triage-features": "workspace:*",
    "@mailwarden/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "imapflow": "^1.0.195",
    "jose": "^6.2.8",
    "mailparser": "^3.7.4",
    "nanoid": "^6.0.1",
    "nodemailer": "^7.0.6",
    "solid-js": "^1.9.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.1",
    "babel-preset-solid": "^1.9.12",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
