{
  "name": "mailwarden",
  "version": "1.0.0",
  "description": "AI-native email operating layer and secure MCP boundary",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/scripts/dev-seed.ts",
    "mcp:stdio": "bun run src/scripts/mcp-stdio.ts",
    "proton:gateway": "bun run src/services/proton-gateway.ts",
    "replay": "bun run src/scripts/replay.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "imapflow": "^1.0.195",
    "jose": "^6.2.8",
    "mailparser": "^3.7.4",
    "nanoid": "^6.0.1",
    "nodemailer": "^7.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
