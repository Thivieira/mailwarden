# Mailwarden Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
MCP_BASE_URL=http://localhost:3000/mcp

# Database (SQLite / D1)
DATABASE_URL=./data/mailwarden.db

# Authentication & Security
AUTH_SECRET=mailwarden-dev-jwt-secret-at-least-32-chars-long!
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KEY_VERSION=v1

# Mailbox Mutation Safety
# When false: mark_read, mark_unread, archive are simulated (dry run).
# Sending always requires explicit payload confirmation regardless of this setting.
MAILBOX_MUTATIONS_ENABLED=false

# Google OAuth (Gmail API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft OAuth (Outlook / Graph API)
MICROSOFT_CLIENT_ID=your-microsoft-app-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# Proton Mail Bridge (IMAP / SMTP)
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025
PROTON_BRIDGE_USERNAME=user@proton.me
PROTON_BRIDGE_PASSWORD=bridge-generated-password
PROTON_BRIDGE_TLS_MODE=STARTTLS

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
