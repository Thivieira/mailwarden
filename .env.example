# Mailwarden Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
MCP_BASE_URL=http://localhost:3000/mcp

# Database (SQLite / D1)
DATABASE_URL=./data/mailwarden.db

# Authentication & Security
AUTH_SECRET=mailwarden-dev-jwt-secret-at-least-32-chars-long!
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KEY_VERSION=v1

# Single-owner dogfood login. In production set OWNER_LOGIN_SECRET via `wrangler secret put`.
OWNER_EMAIL=you@example.com
OWNER_LOGIN_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=false

# Mailbox Mutation Safety
# When false: mailbox organization actions are simulated.
# Explicit email sending still requires the human send-approval flow.
MAILBOX_MUTATIONS_ENABLED=false

# Google OAuth (Gmail API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production example: https://mailwarden.corenet.workers.dev/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Microsoft OAuth (Outlook / Graph API)
MICROSOFT_CLIENT_ID=your-microsoft-app-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Production example: https://mailwarden.corenet.workers.dev/auth/callback/microsoft
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback/microsoft
MICROSOFT_TENANT_ID=common

# Proton Mail Bridge local gateway (runs beside Proton Bridge, not inside the Worker)
PROTON_GATEWAY_API_KEY=replace-with-a-long-random-gateway-key
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025
PROTON_BRIDGE_USERNAME=bridge-generated-username
PROTON_BRIDGE_PASSWORD=bridge-generated-password
PROTON_BRIDGE_TLS_MODE=STARTTLS

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
